# =====================================================================
# AI CHAT BACKEND CONFIGURATION
# Copy this file to .env and configure with your credentials
# =====================================================================

PORT=8080

# PostgreSQL Connection String (Neon, Supabase, RDS, or local)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Authentication Secrets (Generate secure random string for production)
JWT_SECRET=super-secret-jwt-key-replace-in-production-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Server-Side AI Provider Configuration
# Works with OpenRouter, OpenAI, Groq, DeepSeek, or Ollama
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-your-openrouter-key-here
# Free models on OpenRouter:
# 1) nvidia/nemotron-3-ultra-550b-a55b:free  (Recommended: 550B powerful model)
# 2) cohere/north-mini-code:free             (Ultra fast coding & general chat)
# 3) nvidia/nemotron-3-super-120b-a12b:free  (120B reasoning model)
# 4) openrouter/free                         (Auto-routed free model)
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_SYSTEM_PROMPT=You are an intelligent, helpful, and concise AI research assistant. Respond cleanly and use markdown for formatting.
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# Network & Security
ALLOWED_ORIGINS=*
MAX_REQUEST_SIZE_MB=50

# Multimodal Storage & Processing
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ENABLE_DOCUMENT_RAG=true
ENABLE_VISION_ROUTING=true

# =====================================================================
# REVENUECAT & GOOGLE PLAY SUBSCRIPTION CONFIGURATION
# =====================================================================
# RevenueCat Webhook Authorization Token
# Configure this secret token in RevenueCat Dashboard -> Project -> Integrations -> Webhooks -> Authorization Header
REVENUECAT_WEBHOOK_AUTH_TOKEN=super-secret-revenuecat-webhook-token

# RevenueCat Secret API Key (V2 API) for optional server-side customer lookup
# Get from: RevenueCat Dashboard -> Project Settings -> API Keys -> Secret API Key
REVENUECAT_API_KEY=

# Android Application Package Name (used for Google Play subscription management links)
ANDROID_PACKAGE_NAME=com.aichat.app.mobile

